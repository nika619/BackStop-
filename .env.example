# Environment configuration for Backstop
# IMPORTANT: Dummy values only. Never commit real keys to version control.

# Server & Mode
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DRY_RUN=true

# Database (defaults to SQLite in data/backstop.db if DATABASE_URL is unset)
DATABASE_URL=sqlite:///./data/backstop.db

# Security & Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=dummy_secret_key_placeholder
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret_for_testing_only

# LLM Provider - Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operational Parameters
POLICY_VERSION=2026.09.01
INCENTIVE_BUDGET_INR=50000
MAX_ATTEMPTS=3
QUIET_HOURS_START_IST=9
QUIET_HOURS_END_IST=21
